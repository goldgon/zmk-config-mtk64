/ {
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&trackball>;
        input-processors = <&zip_aml 6 5000>, <&zip_dynamic_rate_limit 1 8>;

        snipe {
            layers = <3>;
            input-processors = <&zip_xy_scaler 1 40>;
            process-next;
        };

        scroll {
            layers = <1>;
            input-processors = 
                <&zip_xy_to_scroll_mapper>, 
                <&zip_scroll_inverter>, 
                <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>, 
//<&zip_scroll_x_scaler 0 1>,
                <&zip_scroll_scaler 1 64>;
            process-next;
        };
    };
};

&spi0 {
    status = "okay";
};

&trackball { 
    status = "okay";
};

&xiao_serial { status = "disabled"; };
